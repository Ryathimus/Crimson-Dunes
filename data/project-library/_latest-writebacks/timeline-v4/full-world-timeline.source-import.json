  {
    "id": "timeline-mid-1600s",
    "dateText": "Mid 1600s",
    "title": "Portuguese traders from Timor began raiding Melville Island, just off the coast of Darwin,",
    "summary": "Portuguese traders from Timor began raiding Melville Island, just off the coast of Darwin, to kidnap young male Tiwi for slaves. The Portuguese continue their raids until about 1800.",
